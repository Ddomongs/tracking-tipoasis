UNIPASS_API_KEY=
UNIPASS_API_URL=https://unipass.customs.go.kr:38010/ext/rest/cargCsclPrgsInfoQry/retrieveCargCsclPrgsInfo
NEXT_PUBLIC_BASE_URL=https://tracking.tipoasis.com

# QuickStar server-only API settings. Never expose these with NEXT_PUBLIC_.
QUICKSTAR_USER_ID=
QUICKSTAR_USER_SESSION=
QUICKSTAR_API_BASE_URL=https://quickstar.co.kr/elpisapi2

# Password for the internal CS helper (/internal/*). Browser basic auth, any username.
# Unset in production hides the pages entirely.
INTERNAL_ACCESS_PASSWORD=

# Search console ownership tags (public values, optional): docs/ops/search-registration.md
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# Staff-edited site settings (docs/ops/site-settings.md). GLOBAL_CONFIG (older name EDGE_CONFIG) is added by Vercel when the store is connected.
GLOBAL_CONFIG=
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
